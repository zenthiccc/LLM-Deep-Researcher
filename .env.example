# Model provider: openai | gemini
MODEL_PROVIDER=gemini
# Optional model override (defaults: gpt-5.4-mini for openai, gemini-3.5-flash-lite for gemini)
# DEFAULT_MODEL_NAME=gemini-3.5-flash-lite

# Provider keys (only the one for MODEL_PROVIDER is required)
OPENAI_API_KEY=
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

HOW_MANY_SEARCHES=3

# Gemini free-tier limits, used for the usage meter and rate limiting (Gemini only).
# Copy them from Google AI Studio -> Rate limits for your model. Leave one blank to only count usage.
# GEMINI_RPM=15          # requests per minute: calls are spaced out to stay under this
# GEMINI_RPD=1000        # requests per day: a run won't start if there aren't enough left
# GEMINI_SEARCH_LIMIT=5000   # Google Search grounding requests
# GEMINI_SEARCH_PERIOD=month # day | month (Gemini 3 models have a monthly allowance)
