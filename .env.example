# Model provider: openai | gemini
MODEL_PROVIDER=gemini
# Optional model override (defaults: gpt-5.4-mini for openai, gemini-3.5-flash-lite for gemini)
# DEFAULT_MODEL_NAME=gemini-3.5-flash-lite

# Provider keys (only the one for MODEL_PROVIDER is required)
OPENAI_API_KEY=
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

HOW_MANY_SEARCHES=5

# Delivery: true sends email via SMTP, false sends a Pushover notification
USE_EMAIL=true
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=
EMAIL_APP_PASSWORD=
PUSHOVER_USER=
PUSHOVER_TOKEN=
